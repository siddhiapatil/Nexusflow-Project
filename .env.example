# NexusFlow — Environment Configuration Template
# Copy this to nexusflow/server/.env and customize for your environment

# ===== Server =====
PORT=4000

# ===== MongoDB Connection =====
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=nexusflow
TELEMETRY_COLLECTION=telemetry

# ===== Data Retention (seconds; 0 = no expiry) =====
# 2592000 = 30 days; set to 0 for indefinite storage
RETENTION_SECONDS=2592000

# ===== Ingestion Tuning (performance parameters) =====
# Batch size for bulk inserts
INGEST_BATCH_SIZE=1000

# Flush interval (milliseconds) for bounded buffering
INGEST_FLUSH_MS=100

# Maximum concurrent inflight batches
INGEST_MAX_INFLIGHT=8

# Maximum queued measurements before backpressure
INGEST_MAX_QUEUE=200000

# Maximum measurements per HTTP request
INGEST_MAX_REQUEST_BATCH=5000

# MongoDB connection pool size
MONGO_POOL_SIZE=50

# ===== Optional: Client / UI =====
# Configure CORS if client runs on different origin
VITE_API_URL=http://localhost:4000
